# 复制为 .env 后设置自己的管理密码，不要把真实密码发到聊天中。
ADMIN_PASSWORD=replace-with-a-long-random-password
# 默认供同机 Nginx 代理 HTTPS；公网 HTTP 配置见 README。
BIND_ADDRESS=127.0.0.1
APP_PORT=8000
COOKIE_SECURE=1

# 可选：企业微信自建应用；真实Secret仅填服务器.env，不上传GitHub。
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_PUBLIC_URL=https://score.example.com
